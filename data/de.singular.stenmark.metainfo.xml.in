<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>de.singular.stenmark</id>

  <name>Stenmark</name>
  <summary>Your markdown librarian</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>

  <description>
    <p>
      Stenmark is your markdown librarian: a GTK4 Markdown reader,
      organizer and editor built with libadwaita. It features a split-pane editor with live preview, syntax
      highlighting, table of contents navigation, and a folder-based document
      browser.
    </p>
    <p>Features:</p>
    <ul>
      <li>Live preview with synchronized scrolling</li>
      <li>CodeMirror 6 editor with Markdown syntax highlighting</li>
      <li>Folder-based document sidebar with pinning support</li>
      <li>Code block syntax highlighting with copy button</li>
      <li>Interactive task list checkboxes</li>
      <li>Table of contents navigation</li>
      <li>Light and dark theme support</li>
    </ul>
  </description>

  <launchable type="desktop-id">de.singular.stenmark.desktop</launchable>

  <url type="homepage">https://github.com/mkay/stenmark</url>
  <url type="bugtracker">https://github.com/mkay/stenmark/issues</url>
  <url type="vcs-browser">https://github.com/mkay/stenmark</url>

  <developer id="de.singular">
    <name>Kreuder</name>
  </developer>

  <!-- Reachable public URLs, pinned to the commit that added the files so a
       moved branch cannot change what a published listing resolves to; re-pin
       whenever the screenshots are replaced. The first one is the one people
       actually see. -->
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/mkay/stenmark/cd2d829639deef1160eb7c410b7e99fec9540b11/data/screenshots/reader.png</image>
      <caption>Reading a document beside the folder sidebar</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/mkay/stenmark/cd2d829639deef1160eb7c410b7e99fec9540b11/data/screenshots/editor.png</image>
      <caption>Editing Markdown with syntax highlighting</caption>
    </screenshot>
  </screenshots>

  <branding>
    <color type="primary" scheme_preference="light">#99c1f1</color>
    <color type="primary" scheme_preference="dark">#1a5fb4</color>
  </branding>

  <content_rating type="oars-1.1" />

  <!-- Release descriptions are translate="no" deliberately: they are written
       when the release is tagged, and software centres show them in the window
       where they offer that update — which opens before any translation of one
       could exist. Keep the attribute on new entries; a release genuinely
       worth translating can drop it. -->
  <releases>
    <release version="0.8.0" date="2026-08-14">
      <description translate="no">
        <p>Typewriter mode keeps the line you are writing centred in the window. The root folder picker drills down one level at a time instead of listing every folder at once, and changing the root now starts fresh in the folder you picked.</p>
      </description>
    </release>
    <release version="0.7.1" date="2026-08-13">
      <description translate="no">
        <p>A Russian translation, contributed by derVedro.</p>
      </description>
    </release>
    <release version="0.7.0" date="2026-08-10">
      <description translate="no">
        <p>Editing picks up where you were reading: double-click any text to open the editor at that word, and Esc leaves edit mode again. 48 editor themes with a colour preview, and Preferences in a window of its own so nothing dims the editor while you choose one.</p>
      </description>
    </release>
    <release version="0.6.1" date="2026-08-07">
      <description translate="no">
        <p>Corrected the version this metadata reports: it had stopped at 0.3.3, so software centres named the wrong release.</p>
      </description>
    </release>
    <release version="0.6.0" date="2026-08-07">
      <description translate="no">
        <p>German translation and a language picker, a Flatpak of its own, a Support item in the menu, and a move to GPL-3.0-only.</p>
      </description>
    </release>
    <release version="0.5.1" date="2026-07-21">
      <description translate="no">
        <p>The preview pane starts off and remembers your last choice; the sidebar tag list refreshes as tags change.</p>
      </description>
    </release>
    <release version="0.5.0" date="2026-03-19">
      <description translate="no">
        <p>Tagging, and filtering documents by one or more tags.</p>
      </description>
    </release>
    <release version="0.4.5" date="2026-03-17">
      <description translate="no">
        <p>Navigation between linked documents, Stenmark offered as an "Open with" handler, and fixes to the sidebar outside the root folder.</p>
      </description>
    </release>
    <release version="0.4.0" date="2026-03-15">
      <description translate="no">
        <p>Renamed from Marklite to Stenmark, with a new icon and AppStream metadata.</p>
      </description>
    </release>
    <release version="0.3.3" date="2026-03-14">
      <description translate="no">
        <p>Switched to Phosphor Icons, fixed opening directories via CLI argument.</p>
      </description>
    </release>
    <release version="0.3.2" date="2026-03-12">
      <description translate="no">
        <p>Better new document behaviour, minor UI improvements.</p>
      </description>
    </release>
    <release version="0.3.0" date="2026-03-11">
      <description translate="no">
        <p>Added pin-to-top for folders, various fixes and cleanup.</p>
      </description>
    </release>
  </releases>

  <requires>
    <display_length compare="ge">360</display_length>
  </requires>

  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>
</component>
